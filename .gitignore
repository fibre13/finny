# Локальный инструментарий (JDK, Android SDK) - устанавливается setup-скриптом, в репозиторий не входит
/tools/

# Gradle
.gradle/
**/build/
local.properties

# Android Studio / IntelliJ
.idea/
*.iml
.DS_Store
captures/
.externalNativeBuild/
.cxx/

# Ключ подписи и секреты - никогда не коммитятся
*.jks
*.keystore
keystore.properties
*.pem
*.p12

# Логи и временные файлы
*.log
/tmp/

# Служебные файлы Python: скрипты переноса графики запускаются из каталога документации.
__pycache__/
*.pyc

# Материалы организатора: используются при разработке, но не распространяются.
# Копия хранится за пределами репозитория.
/6. Департамент финансов города Москвы.pdf
/*Вопросы и ответы*.pdf

# Выгрузки среды дизайна: рабочий промежуточный материал.
# Разборы и перенесённые решения — в docs/design.
/docs/design/from-designer/

# Каталог компилятора Kotlin в рабочем дереве
.kotlin/
