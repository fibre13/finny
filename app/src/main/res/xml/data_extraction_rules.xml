<?xml version="1.0" encoding="utf-8"?>
<!--
    Данные профиля не покидают устройство: исключены из облачного резервного
    копирования и из переноса между устройствами (ТЗ 3.5). Удаление профиля
    выполняется взрослым внутри приложения.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
