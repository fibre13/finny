<?xml version="1.0" encoding="utf-8"?>
<!--
    Правила для Android ниже 12: данные профиля исключены из резервного
    копирования полностью, они хранятся только на устройстве (ТЗ 3.5).
-->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
