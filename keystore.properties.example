# Шаблон файла с параметрами ключа подписи релизной сборки.
#
# Скопируйте этот файл в keystore.properties (в корне репозитория, рядом
# с этим файлом) и заполните реальными значениями. Файл keystore.properties
# уже в .gitignore и никогда не попадёт в репозиторий.
#
# Подробная инструкция по созданию ключа: docs/05-подпись-релиза.md

storeFile=keystore/finny-release.jks
storePassword=
keyAlias=finny
keyPassword=
